<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>mida</ToolCommandName>
        <Description>Builds a .NET repo through MSBuild's static graph with a relocatable output cache on local disk and Google Cloud Storage.</Description>
        <Authors>Gleb Lesnikov</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/spacentropy/MIDA</RepositoryUrl>
    </PropertyGroup>
    <ItemGroup>
        <None Include="../../README.md" Pack="true" PackagePath="/" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Mida.Tests" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../Mida.Store/Mida.Store.csproj" />
    </ItemGroup>
    <ItemGroup>
        <!-- Credentials only: it pulls Newtonsoft.Json, which is not trim-clean, so it stays out of Mida.Store. -->
        <PackageReference Include="Google.Apis.Auth" Version="1.78.0" />
        <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
        <PackageReference Include="Microsoft.Build.Prediction" Version="1.2.44" />
        <PackageReference Include="System.CommandLine" Version="2.0.14" />
        <!-- MSBuild comes from the installed SDK at run time. 18.9 is the oldest supported API; SDK 11 exposes the same one. -->
        <PackageReference Include="Microsoft.Build" Version="18.9.6" ExcludeAssets="runtime" PrivateAssets="all" />
        <PackageReference Include="Microsoft.Build.Framework" Version="18.9.6" ExcludeAssets="runtime" PrivateAssets="all" />
        <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.9.6" ExcludeAssets="runtime" PrivateAssets="all" />
        <PackageReference Include="Microsoft.NET.StringTools" Version="18.9.6" ExcludeAssets="runtime" PrivateAssets="all" />
    </ItemGroup>
</Project>
