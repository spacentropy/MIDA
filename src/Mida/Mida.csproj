<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>mida</ToolCommandName>
        <!-- A build has no pauses to keep short. Without the background collector, evaluating 128 projects took 0.79 s, not 0.98 s. -->
        <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
        <Description>Builds a .NET repo through MSBuild's static graph with a relocatable output cache on local disk and Google Cloud Storage.</Description>
        <Authors>Gleb Lesnikov</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/spacentropy/MIDA</RepositoryUrl>
    </PropertyGroup>
    <ItemGroup>
        <None Include="../../README.md" Pack="true" PackagePath="/" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Mida.Tests" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../Mida.Store/Mida.Store.csproj" />
    </ItemGroup>
    <ItemGroup>
        <!-- Credentials only: it pulls Newtonsoft.Json, which is not trim-clean, so it stays out of Mida.Store. -->
        <PackageReference Include="Google.Apis.Auth" />
        <PackageReference Include="Microsoft.Build.Locator" />
        <PackageReference Include="Microsoft.Build.Prediction" />
        <PackageReference Include="System.CommandLine" />
        <!-- MSBuild comes from the installed SDK at run time. -->
        <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" PrivateAssets="all" />
        <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
        <PackageReference Include="Microsoft.Build.Utilities.Core" ExcludeAssets="runtime" PrivateAssets="all" />
        <PackageReference Include="Microsoft.NET.StringTools" ExcludeAssets="runtime" PrivateAssets="all" />
    </ItemGroup>
</Project>
