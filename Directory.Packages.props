<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <!-- Do not bump the net10.0 pin: 18.9.6 is the oldest supported API and the last MSBuild with a net10.0 build. Prediction needs 18.11 or newer on net11.0. -->
        <MidaMSBuildVersion>18.12.2</MidaMSBuildVersion>
        <MidaMSBuildVersion Condition="'$(TargetFramework)' == 'net10.0'">18.9.6</MidaMSBuildVersion>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
        <PackageVersion Include="Google.Apis.Auth" Version="1.78.0" />
        <PackageVersion Include="Microsoft.Build.Locator" Version="1.11.2" />
        <PackageVersion Include="Microsoft.Build.Prediction" Version="1.2.48" />
        <PackageVersion Include="System.CommandLine" Version="3.0.0" />
        <PackageVersion Include="Testcontainers.FakeGcsServer" Version="4.17.0" />
        <PackageVersion Include="TUnit" Version="1.87.12" />
        <PackageVersion Include="Microsoft.Build" Version="$(MidaMSBuildVersion)" />
        <PackageVersion Include="Microsoft.Build.Framework" Version="$(MidaMSBuildVersion)" />
        <PackageVersion Include="Microsoft.Build.Utilities.Core" Version="$(MidaMSBuildVersion)" />
        <PackageVersion Include="Microsoft.NET.StringTools" Version="$(MidaMSBuildVersion)" />
    </ItemGroup>
</Project>
