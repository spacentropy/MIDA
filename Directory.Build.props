<Project>
    <PropertyGroup>
        <!-- A host cannot load MSBuild from an SDK newer than its runtime. See docs/notes/project-cache-plugin.md -->
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Company>Gleb Lesnikov</Company>
        <Copyright>2026 - $([System.DateTime]::Now.Year)</Copyright>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <AnalysisMode>All</AnalysisMode>
        <AnalysisLevel>latest</AnalysisLevel>
        <!-- A CLI has no SynchronizationContext to avoid. -->
        <NoWarn>$(NoWarn);CA2007</NoWarn>
        <!-- NativeAOT is deferred, not dropped: keep every assembly trim/AOT-clean. See docs/notes/nativeaot.md -->
        <IsAotCompatible>true</IsAotCompatible>
        <PackageProjectUrl>https://github.com/spacentropy/MIDA</PackageProjectUrl>
        <PackageReleaseNotes>https://github.com/spacentropy/MIDA/releases</PackageReleaseNotes>

    </PropertyGroup>
    <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'">
        <Features>$(Features);runtime-async=on</Features>
    </PropertyGroup>
</Project>