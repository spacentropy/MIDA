<Project>
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Company>Gleb Lesnikov</Company>
        <Copyright>2026 - $([System.DateTime]::Now.Year)</Copyright>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <AnalysisMode>All</AnalysisMode>
        <AnalysisLevel>latest</AnalysisLevel>
        <!-- NativeAOT is deferred, not dropped: keep every assembly trim/AOT-clean. See docs/notes/nativeaot.md -->
        <IsAotCompatible>true</IsAotCompatible>
        <PackageProjectUrl>https://github.com/spacentropy/MIDA</PackageProjectUrl>
        <PackageReleaseNotes>https://github.com/spacentropy/MIDA/releases</PackageReleaseNotes>

        <Features>$(Features);runtime-async=on</Features>
    </PropertyGroup>
</Project>