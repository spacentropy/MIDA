<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsTestProject>true</IsTestProject>
        <!-- Never shipped, and TUnit's collection equivalence uses reflection. -->
        <IsAotCompatible>false</IsAotCompatible>
        <!-- Test classes stay public and CA1515 wants them internal in an Exe. Small file reads need no async. -->
        <NoWarn>$(NoWarn);CA1515;CA1849</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Testcontainers.FakeGcsServer" Version="4.16.0" />
        <PackageReference Include="TUnit" Version="1.81.5" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../../src/Mida/Mida.csproj" />
    </ItemGroup>
</Project>
